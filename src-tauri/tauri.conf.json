{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mi Aventura con la Guitarra",
  "version": "1.0.0",
  "identifier": "cl.vladimiracuna.guitarraadventure",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mi Aventura con la Guitarra",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Aprende guitarra paso a paso",
    "longDescription": "Aplicación educativa, privada y sin publicidad con 24 lecciones, afinador cromático, metrónomo y seguimiento local para acompañar el aprendizaje inicial de la guitarra.",
    "copyright": "Copyright © 2026 Vladimir Acuña",
    "publisher": "Vladimir Acuña",
    "homepage": "https://github.com/vladimiracunadev-create/guitarra-adventure",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
